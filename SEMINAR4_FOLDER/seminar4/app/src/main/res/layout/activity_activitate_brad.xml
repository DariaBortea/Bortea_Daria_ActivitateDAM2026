<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date despre brad"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etInaltime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Înălțime (m)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etPret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Preț (lei)"
            android:inputType="numberDecimal" />

        <CheckBox
            android:id="@+id/cbAdult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Este adult" />

        <Switch
            android:id="@+id/swSuport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Are suport" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tip brad" />

        <Spinner
            android:id="@+id/spTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <RadioGroup
            android:id="@+id/rgMaterial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbNatural"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Natural" />

            <RadioButton
                android:id="@+id/rbArtificial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artificial" />
        </RadioGroup>

        <RatingBar
            android:id="@+id/rbRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:numStars="5"
            android:stepSize="0.5" />

        <Button
            android:id="@+id/btnSalveaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Salvează" />
    </LinearLayout>
</ScrollView>